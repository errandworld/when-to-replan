# Copy to .env and fill in. .env is not committed.

# LiteLLM reads these names; check each provider's page if a call returns an auth error.
 
# gemini/gemini-3.5-flash-lite
GEMINI_API_KEY=
 
# nvidia_nim/nvidia/nemotron-3.5-super-v1-120b-a12b
# LiteLLM's nvidia_nim provider reads NVIDIA_NIM_API_KEY (not NVIDIA_API_KEY). Verify with
# `python -m app.llm nvidia_nim/nvidia/nemotron-3.5-super-v1-120b-a12b` before relying on it.
NVIDIA_NIM_API_KEY=

# ollama/qwen3.8:27b runs on a local Ollama server and needs no key.
# Set OLLAMA_API_BASE if it is not at http://localhost:11434.
OLLAMA_API_BASE=
# Optional client-side throttle for a rate-limited account: calls are held 60 / LLM_RPM
# apart. Leave it unset unless your key is hitting 429s.
LLM_RPM=
